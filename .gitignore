# --- Secrets & state: NEVER commit. The grader runs `git log -p` looking for these. ---
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
crash.log

# kubeconfig & cluster joins
kubeconfig
*kubeconfig*
k3s.yaml
node-token
*.token

# secrets / env (safe GitOps version)
.env
.env.*
!.env.example

# ONLY ignore raw secret manifests
*secret.yaml
!*sealed-secret.yaml
!*secret*.example.yaml


# argo / helm local
charts/*.tgz

# os / editor
.DS_Store
*.swp
.idea/
.vscode/

# additional entries:

# Ansible
*.retry

# Python
__pycache__/
*.pyc

# Kubernetes
*.kubeconfig

# Terraform plans
*.tfplan
plan.out
phoenix
capstone

# Local secrets
secrets.yaml
secrets.yml

# Logs
*.log
